ground spacing, and native survey or GPS accuracy is not inferred from this. No private course coordinates, diagram coordinates, timing location or nominal distance define any vertex. Independently digitized aerial centerline: 2650.6 m. Direction, historical configuration and fine corner alignment remain draft; no course coordinates come from the comparison catalogue.","Estimated constant-width corridor: width is stored in track.json; inner, outer and ideal lines are calculated in the browser from the mapped trace. Local widening and earlier boundary corrections are not retained by this approximation."],"model3d":{"schemaVersion":1,"pathMethod":"constant-width-trace-v1","startOffsetM":0,"referenceLengthM":2650.6,"elevationMethod":"periodic-monotone-cubic","elevation":[[0,2.07],[116.80610169491524,3.656],[233.61220338983048,2.772],[272.5475706214689,4.615],[311.48293785310733,8.497],[389.3536723163842,13.706],[467.22440677966097,20.481],[506.1597740112994,22.086],[545.0951412429378,21.816],[584.0305084745762,22.711],[622.9658757062147,25.269],[739.7719774011299,31.309],[778.7073446327684,27.352],[817.6427118644068,23.968],[895.5134463276836,21.511],[934.4488135593219,18.682],[1012.3195480225988,17.702],[1051.2549152542374,14.998],[1129.125649717514,14.131],[1168.0610169491524,15.547],[1206.996384180791,21.128],[1284.867118644068,14.194],[1323.8024858757062,14.303],[1440.6085875706215,17.177],[1557.4146892655367,17.556],[1635.2854237288136,15.766],[1752.0915254237289,14.5],[1791.0268926553672,16.195],[1868.8976271186439,10.918],[1907.8329943502827,6.15],[1946.7683615819208,4.161],[1985.703728813559,3.96],[2063.574463276836,2.022],[2180.380564971751,1.104],[2413.992768361582,3.927],[2491.8635028248586,2.978],[2608.669604519774,3.085],[2650.6,2.07]],"bankingDeg":0,"quality":{"stationing":"mapped-trace","elevation":"terrain-raster","curbs":"geometry-estimated","borders":"width-estimated"},"corners":[{"distanceM":0,"name":"Start / finish"},{"distanceM":232.12,"name":"Bend