{
  "name": "open-racetrack-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "import:osm": "tsx scripts/import-osm.ts",
    "import:timing": "tsx scripts/import-timing.ts",
    "generate:data": "tsx scripts/data.ts generate",
    "validate:data": "tsx scripts/data.ts validate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run validate:data && npm run validate:europe && npm run generate:data -- --check && npm run typecheck && vite build && tsx scripts/copy-data.ts",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/serve.mjs",
    "discover:europe": "tsx scripts/discover-europe.ts",
    "expand:europe": "tsx scripts/expand-europe.ts",
    "validate:europe": "tsx scripts/validate-europe.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "fast-xml-parser": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0"
  }
}
