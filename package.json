{
  "name": "open-racetrack-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "import:osm": "tsx scripts/import-osm.ts",
    "import:timing": "tsx scripts/import-timing.ts",
    "generate:data": "tsx scripts/data.ts generate",
    "validate:data": "tsx scripts/data.ts validate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "build": "npm run validate:data && npm run validate:europe && npm run validate:world && npm run generate:data -- --check && npm run validate:layouts && npm run typecheck && vite build && tsx scripts/copy-data.ts",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/serve.mjs",
    "discover:europe": "tsx scripts/discover-europe.ts",
    "expand:europe": "tsx scripts/expand-europe.ts",
    "validate:europe": "tsx scripts/validate-europe.ts",
    "discover:world": "tsx scripts/discover-world.ts",
    "expand:world": "tsx scripts/expand-europe.ts --world",
    "validate:world": "tsx scripts/validate-europe.ts --world",
    "preview:install": "node scripts/install-preview.mjs",
    "audit:layouts": "tsx scripts/audit-layouts.ts",
    "reconcile:layouts": "tsx scripts/reconcile-layouts.ts",
    "reconcile:venues": "tsx scripts/reconcile-reference-venues.ts",
    "validate:layouts": "tsx scripts/validate-layout-coverage.ts",
    "recover:layouts": "tsx scripts/reference-recovery.ts",
    "catalogue:complete": "tsx scripts/complete-catalogue.ts",
    "import:relations": "tsx scripts/import-circuit-relations.ts",
    "recover:variants": "tsx scripts/recover-course-variants.ts",
    "discover:circuits": "node scripts/discover-circuit-relations.mjs",
    "research:circuits": "tsx scripts/research-circuit-courses.ts",
    "recover:circuits": "tsx scripts/recover-relation-courses.ts",
    "import:roads": "tsx scripts/import-road-courses.ts",
    "research:gaps": "tsx scripts/research-layout-gaps.ts",
    "audit:archive": "tsx scripts/audit-archive-inventory.ts",
    "import:selections": "tsx scripts/import-course-selections.ts",
    "discover:network": "node scripts/discover-course-network.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.55.0",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "fast-xml-parser": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.1.0"
  }
}
